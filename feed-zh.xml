---
layout: null
sitemap: false
permalink: /feed-zh.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed-zh.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/?lang=zh' | absolute_url }}" rel="alternate" type="text/html" hreflang="zh-CN" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed-zh.xml' | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | escape }}（中文）</title>
  <subtitle>边做，边学，把事情想明白。</subtitle>
  <author>
    <name>{{ site.author | xml_escape }}</name>
  </author>
  {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}
  {% for post in posts limit: 15 %}
    {% assign post_title = post.title_zh | default: post.title | smartify | strip_html | normalize_whitespace | xml_escape %}
    {% assign zh_parts = post.content | split: '<div class="lang-zh' %}
    {% if zh_parts.size > 1 %}
      {% assign zh_content = zh_parts[1] | prepend: '<div class="lang-zh' | replace: ' lang-hidden', '' | strip %}
    {% else %}
      {% assign zh_content = post.content | strip %}
    {% endif %}
    {% assign post_summary = post.description_zh | default: post.description | default: post.excerpt %}
    <entry xml:lang="zh-CN">
      <title type="html">{{ post_title }}</title>
      <link href="{{ post.url | absolute_url }}?lang=zh" rel="alternate" type="text/html" title="{{ post_title }}" />
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      <id>{{ post.id | absolute_url | xml_escape }}#zh</id>
      <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ zh_content }}]]></content>
      <author>
        <name>{{ post.author | default: site.author | xml_escape }}</name>
      </author>
      {% for category in post.categories %}
        <category term="{{ category | xml_escape }}" />
      {% endfor %}
      {% for tag in post.tags %}
        <category term="{{ tag | xml_escape }}" />
      {% endfor %}
      {% if post_summary and post_summary != empty %}
        <summary type="html"><![CDATA[{{ post_summary | strip_html | normalize_whitespace }}]]></summary>
      {% endif %}
      {% assign post_image = post.image.path | default: post.image %}
      {% if post_image and post_image != site.social_card %}
        {% unless post_image contains "://" %}
          {% assign post_image = post_image | absolute_url %}
        {% endunless %}
        <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post_image | xml_escape }}" />
        <media:content medium="image" url="{{ post_image | xml_escape }}" xmlns:media="http://search.yahoo.com/mrss/" />
      {% endif %}
    </entry>
  {% endfor %}
</feed>
